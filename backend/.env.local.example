# Copy this file to .env.local and fill in your values

# Database (PostgreSQL / Neon)
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://user:password@localhost:5432/portfolio_db

# Email provider: resend (recommended, free tier) or sendgrid.
# If EMAIL_PROVIDER is omitted, it is inferred from the API key that is set.
EMAIL_PROVIDER=resend
# https://resend.com/api-keys
RESEND_API_KEY=re_replace_with_real_key
# SENDGRID_API_KEY=SG.replace_with_real_key

# Contact email settings
# Where notifications arrive. With Resend and no verified domain this must be the
# email of your Resend account.
CONTACT_EMAIL_TO=jonatanzch@gmail.com
# Sender. Without a verified domain in Resend use: onboarding@resend.dev
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Browser origins allowed by CORS, comma separated (production site + Netlify URL)
FRONTEND_URL=https://jonatanzarate.dev

# Server
PORT=3001
NODE_ENV=development
